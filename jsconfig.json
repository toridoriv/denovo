{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "lib": ["es2025", "dom"],
    "noEmit": true,
    "skipLibCheck": true,
    "target": "es2025",
    "types": ["mustache", "jquery"]
  },
  "exclude": ["node_modules"],
  "include": ["public", "typings"]
}
